# Which Index the floor runs on. Disposable users are created here.
INDEX_API_URL=https://protocol.dev.index.network

# A staff account on that Index — any @index.network address. Network creation
# is staff-only, and every run needs its own two-person network.
FLOOR_OPERATOR_EMAIL=floor-operator@index.network
FLOOR_OPERATOR_PASSWORD=

# Authors the agents' turns.
OPENROUTER_API_KEY=
MODEL=google/gemini-3.7-flash

# One shared password for the whole floor. Unset leaves it open.
FLOOR_PASSWORD=

# People who can be seated instead of a disposable one, as email:apiKey pairs.
# Index has no impersonation, so the email alone is not enough: each person
# mints an owner API key from their own account. Their agent, not the floor,
# answers for them.
FLOOR_GUESTS=

PORT=3000

# Domain the disposable seat addresses are minted under. Never receives mail.
FLOOR_SEAT_EMAIL_DOMAIN=floor.index.network

# Turns one seat authors before it stops and hands the run back.
FLOOR_MAX_TURNS=10
FLOOR_POLL_MS=3000
